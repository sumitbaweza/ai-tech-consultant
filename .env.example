# Copy this file to .env, then fill in the two API keys:
#   cp .env.example .env

# --- Claude: used by all three tasks ---
ANTHROPIC_API_KEY=

# --- Voyage AI embeddings: used by Task 1 ---
VOYAGE_API_KEY=

# --- Postgres: local Docker only, change these before sharing the database ---
POSTGRES_PASSWORD=postgres
BRAIN_DB_PASSWORD=brain
INBOX_DB_PASSWORD=inbox
SCOPE_DB_PASSWORD=scope

# --- Task 1: Knowledge Brain API ---
# Comma-separated keys that may call /v1 (X-API-Key header). Tasks 2 and 3 use one of these.
BRAIN_API_KEYS=dev-brain-key

# --- Task 1: the screens at http://localhost:8501 ---
# Who may sign in: comma-separated name:salt:hash entries, the passwords hashed with scrypt.
# The example user is admin with the password brain-demo, for local use only. Make your own
# entry with: uv run --directory task1-knowledge-brain python -m ui.passwords <name>
BRAIN_UI_USERS=admin:a2f613034073634016b7e5ad7676d1b1:b02f3524f4fa62feb42b04d63dd4a1e64548b64310620fdacb1ac41e9928d22f5a057d954517e3667c017cd12bf46bd6f631c535e88d3cc38b894b8296e68fa3

# --- Task 2: Inbox Agent at http://localhost:3000 ---
# Signs the session cookie: 32+ random characters. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=dev-only-inbox-secret-change-me-0123456789
# fixtures: the emails in task2-inbox-agent/fixtures/emails.json, no Google needed.
# gmail: the Gmail account you sign in with (needs the two Google values below).
INBOX_MODE=fixtures
# The demo sign-in for fixtures mode, for local use only
INBOX_DEMO_PASSWORD=inbox-demo
# A Google Cloud OAuth client (Web), redirect URI http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The inbox's key for the Brain's API: one of the keys in BRAIN_API_KEYS above
BRAIN_API_KEY=dev-brain-key
